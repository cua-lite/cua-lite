# cua-lite/androidlab — emulator image for the AndroidLab benchmark.
#
# Each rollout worker spawns one container from this image; the contained
# emulator loads THUDM's Quick Boot snapshot (with seeded contacts / books /
# MP3s / SQLite DBs). Three reasons why we build an image instead of running
# on the host: (1) snapshot.pb hardcodes /root/.android/... paths that aren't
# writable from user-mode; (2) sdkmanager's current "emulator" package is
# 36.5.10, which rejects the 34.x snapshot; (3) upstream's apt deps (libdrm2,
# libxcb-*, libgoogle-perftools4) are missing in most Python base images.
#
# Build context (assembled by scripts/install.sh from .cache/docker-file.zip
# + a pinned emulator 34.2.15 zip + a generated adbkey pair):
#   openlogic-openjdk-8u412-b08-linux-x64-deb.deb
#   sdk-tools-linux-4333796.zip
#   Pixel_7_Pro_API_33.ini
#   Pixel_7_Pro_API_33.avd.zip
#   skins.zip
#   x86_64.zip
#   emulator/         <- extracted from emulator-linux_x64-11906825.zip
#   adbkey, adbkey.pub

# Pinned to bullseye: upstream's Dockerfile was against python:latest and
# patched /etc/apt/sources.list, which moved in Debian 12 to sources.list.d.
FROM python:3.11-bullseye

RUN apt-get update && apt-get install -y -q --no-install-recommends \
      vim unzip libpulse-dev libnss3 \
      libdrm2 libglib2.0-0 libfontconfig1 libxcb-icccm4 libxcb-image0 \
      libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-shape0 \
      libxcb-sync1 libxcb-xfixes0 libxcb-xinerama0 libxcb-xkb1 \
      libxkbcommon0 libxkbcommon-x11-0 libxrender1 libxcomposite1 \
      libxdamage1 libxtst6 libxkbfile1 libegl1 libgles2 libglu1-mesa \
      libxi6 libxcursor1 libxrandr2 libpulse0 libgoogle-perftools4 \
 && rm -rf /var/lib/apt/lists/*

# JDK 8 — AVD tooling requires 8, not the 17+ shipped with python:3.11-bullseye.
COPY openlogic-openjdk-8u412-b08-linux-x64-deb.deb /tmp/
RUN apt-get update && apt install -y /tmp/openlogic-openjdk-8u412-b08-linux-x64-deb.deb \
 && rm -rf /var/lib/apt/lists/* /tmp/openlogic-openjdk-8u412-b08-linux-x64-deb.deb

ENV ANDROID_SDK_ROOT=/root/.android
ENV ANDROID_EMULATOR_HOME=/root/.android
ENV PATH=/root/.android/emulator:/root/.android/tools:/root/.android/tools/bin:/root/.android/platform-tools:$PATH
RUN mkdir -p /root/.android

# SDK tools (sdkmanager lives here).
COPY sdk-tools-linux-4333796.zip /tmp/
RUN unzip -q /tmp/sdk-tools-linux-4333796.zip -d /root/.android \
 && rm /tmp/sdk-tools-linux-4333796.zip

# platform-tools / platforms;android-33 / build-tools;33.0.0. We deliberately
# DO NOT install `emulator` from sdkmanager here — the current package (36.5.10)
# rejects the reference's 34.x snapshot. The pinned emulator is COPY'd below.
RUN yes | sdkmanager --licenses >/dev/null \
 && yes | sdkmanager "platform-tools" "build-tools;33.0.0" "platforms;android-33"

# The AVD bundle (system image + skins + .ini pointers) from THUDM's Drive.
COPY skins.zip Pixel_7_Pro_API_33.ini Pixel_7_Pro_API_33.avd.zip x86_64.zip /tmp/
RUN unzip -q /tmp/skins.zip -d /root/.android/ \
 && mkdir -p /root/.android/avd \
 && cp /tmp/Pixel_7_Pro_API_33.ini /root/.android/avd/ \
 && unzip -q /tmp/Pixel_7_Pro_API_33.avd.zip -d /root/.android/avd/ \
 && mkdir -p /root/.android/system-images/android-33/google_apis/ \
 && unzip -q /tmp/x86_64.zip -d /root/.android/system-images/android-33/google_apis/ \
 && rm /tmp/skins.zip /tmp/Pixel_7_Pro_API_33.avd.zip /tmp/x86_64.zip /tmp/Pixel_7_Pro_API_33.ini

# Pinned emulator 34.2.15 (build 11906825). Placed LAST so rebuilding this
# layer doesn't invalidate the ~25 GB SDK layers above.
COPY emulator/ /root/.android/emulator/

# Pre-bake adb keys so the emulator doesn't abort with "No adb private key
# exists" on first launch. These keys are per-host (generated by install.sh);
# they only authenticate access to the container-local emulator.
COPY adbkey /root/.android/adbkey
COPY adbkey.pub /root/.android/adbkey.pub
RUN chmod 600 /root/.android/adbkey && chmod 644 /root/.android/adbkey.pub

# In-container env-server: the androidlab Python package is what
# actually owns task.judge() / find_package / get_compressed_xml_from_str
# — we install it (+ FastAPI/uvicorn for the HTTP layer) so the host
# can drive everything via RPC without importing androidlab.
RUN pip install --no-cache-dir \
      'android-lab @ git+https://github.com/cua-lite/Android-Lab.git@7a2f0156ea8aee517ab7e3523f41c1c44b460463' \
      fastapi 'uvicorn[standard]'

COPY patches/ /tmp/patches/
RUN git -C /usr/local/lib/python3.11/site-packages apply /tmp/patches/llm-judge-errors.patch \
 && rm -rf /tmp/patches

COPY server.py /usr/local/bin/server.py
RUN chmod +x /usr/local/bin/server.py

# Standard Android emulator port triple + the in-container env-server.
EXPOSE 5554 5555 8554 9554
